# Application
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL="mysql://tributocr:changeme@db:3306/tributocr"

# For docker-compose
DB_ROOT_PASSWORD=changeme
DB_NAME=tributocr
DB_USER=tributocr
DB_PASSWORD=changeme

# Add your other environment variables here
# JWT_SECRET=your-secret-key
# GOOGLE_MAPS_API_KEY=your-api-key
# APPLE_CLIENT_ID=com.example.yourapp
# etc.

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=no-reply@tributocr.com

# Invitations (accept-invite link sent by email; served by this API at GET /invitations/accept)
APP_INVITE_URL=https://links.appdelivo.com/invitations/accept

# Universal / app links for the APP_INVITE_URL host. iOS uses APPLE_TEAM_ID (below) for
# /.well-known/apple-app-site-association; Android needs the SHA-256 of the signing cert
# (Play Console > App integrity > App signing) for /.well-known/assetlinks.json.
# Each file 404s while its value is unset. Defaults match the app's bundle id / package / scheme.
# APP_SCHEME=com.tributcr.savaldev
# IOS_BUNDLE_ID=com.tributcr.savaldev
# ANDROID_PACKAGE_NAME=com.tributcr.savaldev
ANDROID_SHA256_CERT_FINGERPRINTS=
# Optional store links shown on the invitation page when the app isn't installed
APP_STORE_URL=
PLAY_STORE_URL=

# Billing (RevenueCat)
# REVENUECAT_WEBHOOK_AUTH must match the Authorization header value configured for this
# webhook in the RevenueCat dashboard (Project settings > Integrations > Webhooks).
REVENUECAT_WEBHOOK_AUTH=
# Optional: only needed to delete subscribers on account deletion and for ad-hoc REST queries,
# not for the webhook flow.
REVENUECAT_API_KEY=

# Apple Sign In (opcional; requerido para verificar id tokens de Apple en login y para
# revocar tokens en DELETE /api/v1/me — App Review 5.1.1(v)). Sin estas variables la API
# sigue arrancando; AppleOAuthProvider.revokeToken se omite silenciosamente.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Generar la clave p8 en Apple Developer > Certificates, Identifiers & Profiles > Keys.
# Pegar el PEM completo aquí (incluyendo -----BEGIN PRIVATE KEY-----).
APPLE_PRIVATE_KEY=

# Login de prueba para la revisión de App Store / Google Play.
# Permite entrar con usuario y contraseña sin pasar por Google/Apple.
# ⚠️ APAGAR (o borrar) EN CUANTO LA APP QUEDE APROBADA.
# Con TEST_LOGIN_ENABLED distinto de "true" la ruta ni siquiera se monta.
TEST_LOGIN_ENABLED=false
TEST_LOGIN_EMAIL=review@tributocr.com
# Generar con: openssl rand -base64 24 (mínimo 16 caracteres, se valida al arrancar)
TEST_LOGIN_PASSWORD=

# Versión mínima del frontend/app soportada por esta API (semver, ej. "1.2.0").
# Obligatoria y validada al arrancar. Se expone en GET /api/v1/system/min-frontend-version.
MIN_FRONTEND_VERSION=1.2.0
