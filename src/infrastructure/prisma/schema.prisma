// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// ===============================
/// USERS + COMPANIES
/// ===============================

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  name     String
  surnames String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companies UserCompany[]
}

model Company {
  id   String    @id @default(uuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         UserCompany[]
  clients       Client[]
  suppliers     Supplier[]
  products      Product[]
  taxPeriods    TaxPeriod[]
  clientBills   ClientBill[]
  supplierBills SupplierBill[]
}

model UserCompany {
  id String @id @default(uuid())

  userId    String
  companyId String

  role CompanyRole @default(OWNER)

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
}

enum CompanyRole {
  OWNER
  ACCOUNTANT
  EMPLOYEE
}

/// ===============================
/// CLIENTS + SUPPLIERS
/// ===============================

model Client {
  id          String     @id @default(uuid())
  name        String     @unique
  phoneNumber String?    @unique
  email       String?    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  bills ClientBill[]
}

model Supplier {
  id   String    @id @default(uuid())
  name String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  bills SupplierBill[]
}

/// ===============================
/// PRODUCTS (Sales Catalog)
/// ===============================

model Product {
  id   String    @id @default(uuid())
  name String

  grossPrice Decimal @db.Decimal(12, 2)
  ivaRate  Decimal @default(13.00) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  clientBillItems ClientBillItem[]
}

/// ===============================
/// SALES (CLIENT INVOICES)
/// ===============================

model ClientBill {
  id        String      @id @default(uuid())
  number    String   @unique
  issueDate DateTime @default(now())

  status BillStatus @default(PENDING)

  subtotal Decimal @db.Decimal(12, 2)
  ivaTotal Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  items ClientBillItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientBillItem {
  id String @id @default(uuid())

  billId String
  bill   ClientBill @relation(fields: [billId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  description String
  quantity    Decimal @db.Decimal(12, 2)

  unitPrice Decimal @db.Decimal(12, 2)
  ivaRate   Decimal @db.Decimal(5, 2)

  ivaAmount Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
}

/// ===============================
/// PURCHASES (SUPPLIER EXPENSES)
/// ===============================

model SupplierBill {
  id        String      @id @default(uuid())
  number    String?
  issueDate DateTime @default(now())

  status BillStatus @default(PENDING)

  subtotal Decimal @db.Decimal(12, 2)
  ivaTotal Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  items SupplierBillItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupplierBillItem {
  id String @id @default(uuid())

  billId String
  bill   SupplierBill @relation(fields: [billId], references: [id])

  description String
  quantity    Decimal @db.Decimal(12, 2)

  unitPrice Decimal @db.Decimal(12, 2)
  ivaRate   Decimal @db.Decimal(5, 2)

  deductible Boolean @default(true)

  ivaAmount Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
}

/// ===============================
/// IVA DECLARATION (MONTHLY PERIODS)
/// ===============================

model TaxPeriod {
  id String @id @default(uuid())

  month Int
  year  Int

  /// IVA collected from sales
  ivaCollected Decimal @db.Decimal(12, 2)

  /// IVA deductible from expenses
  ivaDeductible Decimal @db.Decimal(12, 2)

  /// Final IVA to pay Hacienda
  ivaToPay Decimal @db.Decimal(12, 2)

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month, year, companyId])
}

/// ===============================
/// ENUMS
/// ===============================

enum BillStatus {
  PENDING
  PAID
  CANCELLED
}
